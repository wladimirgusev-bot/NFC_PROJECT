<?xml version="1.0" encoding="utf-8"?>
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/service_desc"
    android:requireDeviceUnlock="true">

    <!--
      Постоянно регистрируем только уникальный AID, чтобы не конфликтовать
      со встроенным Samsung/Android сервисом NFC Forum NDEF.
      Стандартный NDEF AID D2760000850101 регистрируется динамически
      только после нажатия "Передать по NFC".
    -->
    <aid-group
        android:category="other"
        android:description="@string/service_desc">
        <aid-filter android:name="F0010203040506" />
    </aid-group>
</host-apdu-service>
